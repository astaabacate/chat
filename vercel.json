{
  "$schema": "https://json.schemastore.org/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev -- --host",
  "installCommand": "npm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "regions": ["sfo1"],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
